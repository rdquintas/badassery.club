{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Badassery events",
  "description": "Upcoming events shown in the Shotgun-style grid on the home page (config/events.yaml).",
  "type": "object",
  "additionalProperties": false,
  "required": ["venue_url", "venue_name", "items"],
  "properties": {
    "venue_url": {
      "description": "Shotgun venue page, used by the \"Ver mais\" button.",
      "type": "string",
      "format": "uri"
    },
    "venue_name": {
      "description": "Venue line shown under each event title, e.g. \"Bar Badassery\".",
      "type": "string"
    },
    "items": {
      "description": "Events, listed in this order.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "date", "time", "price", "url", "image"],
        "properties": {
          "title": { "description": "Event name, as on Shotgun.", "type": "string" },
          "date": {
            "description": "Date as YYYY-MM-DD.",
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "time": {
            "description": "Start time as HH:MM (quote it in YAML).",
            "type": "string",
            "pattern": "^\\d{2}:\\d{2}$"
          },
          "price": {
            "description": "Lowest ticket price in euros; 0 shows \"Grátis\".",
            "type": "number",
            "minimum": 0
          },
          "sold_out": { "description": "Shows \"Esgotado\" instead of the price.", "type": "boolean" },
          "tags": {
            "description": "Genre tags; the first three are shown, then \"+N\".",
            "type": "array",
            "items": { "type": "string" }
          },
          "url": {
            "description": "Shotgun event page.",
            "type": "string",
            "format": "uri"
          },
          "image": {
            "description": "Basename of a 16:9 cover in src/assets/img/events/ with -600/-1200 .avif/.webp/.jpg versions.",
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          }
        }
      }
    }
  }
}
