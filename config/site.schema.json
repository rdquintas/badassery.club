{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Badassery site config",
  "description": "Site-wide settings used by the build (config/site.yaml).",
  "type": "object",
  "additionalProperties": false,
  "required": ["email", "address", "booking_url", "hours"],
  "properties": {
    "email": {
      "description": "Contact email shown in the footer.",
      "type": "string",
      "format": "email"
    },
    "address": {
      "description": "Venue address.",
      "type": "object",
      "additionalProperties": false,
      "required": ["street", "postal_code", "city"],
      "properties": {
        "street": { "description": "Street and number.", "type": "string" },
        "postal_code": {
          "description": "Portuguese postal code (NNNN-NNN).",
          "type": "string",
          "pattern": "^\\d{4}-\\d{3}$"
        },
        "city": { "description": "City name.", "type": "string" }
      }
    },
    "booking_url": {
      "description": "Zenchef reservation link used by the RESERVAR buttons.",
      "type": "string",
      "format": "uri"
    },
    "google_maps_url": {
      "description": "Google Maps link for the venue address.",
      "type": "string",
      "format": "uri"
    },
    "hours": {
      "description": "Opening hours; each entry is one paragraph in the footer.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["days", "time"],
        "properties": {
          "days": { "description": "e.g. \"Friday and Saturday\"", "type": "string" },
          "time": { "description": "e.g. \"from 7 PM to 3 AM\"", "type": "string" }
        }
      }
    }
  }
}
